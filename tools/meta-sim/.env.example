# Settings of the stand-in. The product is told about it only through ITS OWN settings (see the "Settings" tab of the simulator, or README.md).
SIM_PORT=9100
SIM_WEBHOOK_URL=http://host.docker.internal:8001/webhooks/whatsapp   # the product's gateway `receive` (the callback URL you would give Meta)
SIM_APP_SECRET=sim-app-secret-1234567890    # = META_APP_SECRET in deploy/gateway/.env: the simulator signs every webhook with it
SIM_VERIFY_TOKEN=sim-verify-token-1234567890 # = META_VERIFY_TOKEN in deploy/gateway/.env
SIM_BIND=127.0.0.1                          # who may open the phones: this machine only (the stand-in has no sign-in). A LAN address opens it to that network
