# Settings for the split stacks (backend.yml, ai-engine.yml). Copy to deploy/standalone/.env and fill in.
# This file is separate from deploy/.env on purpose: that one belongs to the demo stack and carries demo flags.

APP_ENV=staging                 # dev | staging | production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173

# ---- database (external; not part of compose). To move it, change these four.
# From inside a container, the host machine is host.docker.internal.
DATABASE_URL=postgresql://app_user:CHANGE_ME@host.docker.internal:5432/salesai
PRICING_DATABASE_URL=postgresql://app_pricing:CHANGE_ME@host.docker.internal:5432/salesai
SYSTEM_DATABASE_URL=postgresql://app_system:CHANGE_ME@host.docker.internal:5432/salesai
MIGRATION_DATABASE_URL=postgresql://app_owner:CHANGE_ME@host.docker.internal:5432/salesai

# ---- secrets (every container of both stacks must share the same values)
MASTER_KEY=                     # base64 of 32 bytes
JWT_SECRET=                     # >= 32 chars
OTP_SECRET=                     # >= 32 chars
META_APP_SECRET=
META_VERIFY_TOKEN=

# ---- AI engine
LLM_PROVIDER=anthropic          # anthropic | local (deterministic stand-in, dev/test only)
ANTHROPIC_API_KEY=
AI_CONCURRENCY=8                # jobs each AI engine replica runs at once; add replicas with: stack.ps1 ai -Scale N

# ---- sign-in and channels (safe defaults; production refuses the demo flags)
OTP_CHANNEL=whatsapp_cloud      # simulator for local dev
OTP_ACCEPT_ANY=false
SIMULATOR_ENABLED=false
META_APP_ID=
META_CONFIG_ID=
