# Settings for the channel gateway (deploy/gateway/docker-compose.yml). Copy to deploy/gateway/.env and fill in.
# Separate from deploy/.env (the demo) and from the other stacks on purpose. Never commit the filled-in file.
# Where each Meta value comes from: docs/WHATSAPP_GO_LIVE.md

APP_ENV=production              # dev | staging | production. production refuses placeholders, the simulator and test payment/LLM modes
LOG_LEVEL=INFO
RECEIVE_PORT=8001               # the only published port. Put a TLS proxy or tunnel with a valid certificate in front of it

# ---- database (external; to move it, change these four)
DATABASE_URL=postgresql://app_user:CHANGE_ME@host.docker.internal:5432/salesai
PRICING_DATABASE_URL=postgresql://app_pricing:CHANGE_ME@host.docker.internal:5432/salesai
SYSTEM_DATABASE_URL=postgresql://app_system:CHANGE_ME@host.docker.internal:5432/salesai
MIGRATION_DATABASE_URL=postgresql://app_owner:CHANGE_ME@host.docker.internal:5432/salesai

# ---- Meta (WhatsApp Business Platform). Webhooks are SIGNED with the app secret, not encrypted: no decryption key exists.
META_APP_ID=                    # App Dashboard > App settings > Basic
META_APP_SECRET=                # same page, "App secret". Verifies X-Hub-Signature-256 on every webhook. Server side only
META_VERIFY_TOKEN=              # you invent it (32+ random characters); paste the same value into WhatsApp > Configuration
META_CONFIG_ID=                 # Facebook Login for Business > configuration with the "WhatsApp Embedded Signup" variation
META_GRAPH_VERSION=v26.0        # use the Graph API version your app shows; versions expire after about two years
META_GRAPH_BASE=https://graph.facebook.com

# ---- encryption (every stack that talks to the same database must use the same value)
# Only the `send` part receives this. `receive` and `inbound` never see it (INV-11).
MASTER_KEY=                     # base64 of 32 random bytes (openssl rand -base64 32). Wraps each business's key that encrypts its
                                # WhatsApp token. LOSE IT AND EVERY BUSINESS MUST RECONNECT. Back it up somewhere safe
# JWT_SECRET and OTP_SECRET are not used by the gateway; they belong to the API stack.

# ---- production refuses LLM_PROVIDER=local even though the gateway never calls a model
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ---- channels (production refuses the simulator and any-code sign-in)
OTP_CHANNEL=whatsapp_cloud
SIMULATOR_ENABLED=false
PAYMENT_PROVIDER=manual

# ---- scaling (jobs each copy runs at once; add copies with: stack.ps1 gateway -Service send -Scale N)
INBOUND_CONCURRENCY=8
SEND_CONCURRENCY=8
