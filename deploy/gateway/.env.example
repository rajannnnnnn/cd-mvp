# Settings for the GATEWAY part (deploy/gateway): the only part that talks to Meta. Copy to deploy/gateway/.env and fill in.
# Never commit the filled-in file. Where each Meta value comes from: docs/WHATSAPP_GO_LIVE.md
# It needs no AI model key: the gateway never calls a model.

APP_ENV=production              # dev | staging | production. production refuses placeholders and the simulator
LOG_LEVEL=INFO
RECEIVE_PORT=8001               # the only published port. Put a TLS proxy or tunnel with a valid certificate in front of it

# ---- database (external; the same four values as every other part)
DATABASE_URL=postgresql://app_user:CHANGE_ME@host.docker.internal:5432/salesai
SYSTEM_DATABASE_URL=postgresql://app_system:CHANGE_ME@host.docker.internal:5432/salesai
MIGRATION_DATABASE_URL=postgresql://app_owner:CHANGE_ME@host.docker.internal:5432/salesai

# ---- Meta (WhatsApp Business Platform). Webhooks are SIGNED with the app secret, not encrypted: no decryption key exists.
META_APP_ID=                    # App Dashboard > App settings > Basic
META_APP_SECRET=                # same page, "App secret". `receive` verifies every webhook with it; `send` completes sign-ups. Server side only
META_VERIFY_TOKEN=              # you invent it (32+ random characters); paste the same value into WhatsApp > Configuration. `receive` only
META_CONFIG_ID=                 # Facebook Login for Business > configuration with the "WhatsApp Embedded Signup" variation
META_GRAPH_VERSION=v26.0        # use the Graph API version your app shows; versions expire after about two years
META_GRAPH_BASE=https://graph.facebook.com

# ---- encryption (SAME value as the web part). Only `send` receives it; `receive` and `inbound` never see it (INV-11).
MASTER_KEY=                     # base64 of 32 random bytes (openssl rand -base64 32). LOSE IT AND EVERY BUSINESS MUST RECONNECT. Back it up

# ---- the platform's own WhatsApp number (our own business account): sign-in codes, and alerts when a shop's own number is down
OTP_CHANNEL=whatsapp_cloud      # `simulator` for local development only
PLATFORM_SENDER_PHONE_NUMBER_ID=
PLATFORM_WA_ACCESS_TOKEN=       # required by `send` when OTP_CHANNEL=whatsapp_cloud. Only `send` receives it

# ---- throughput
INBOUND_CONCURRENCY=8           # jobs each `inbound` copy runs at once
SEND_CONCURRENCY=8              # jobs each `send` copy runs at once (Meta limits per number still apply)

# ---- queue (only if you run Redis instead of Postgres)
QUEUE_BACKEND=postgres
REDIS_URL=

# ---- optional (safe defaults)
# BACKEND_IMAGE=chatdeal-backend:local     # the image every part runs; build it once and reuse it
# SIMULATOR_ENABLED=false                  # development only: the simulated WhatsApp network. Production refuses it
