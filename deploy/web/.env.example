# Settings for the WEB part (deploy/web): the site, its API and its timer. Copy to deploy/web/.env and fill in.
# Never commit the filled-in file. It holds no Meta app secret and no model key: by design the web part cannot reach WhatsApp.

APP_ENV=production              # dev | staging | production. production refuses placeholders, the simulator and test payments
LOG_LEVEL=INFO
WEB_PORT=8080                   # the published port. Put a TLS proxy in front of it
# WEB_BIND=127.0.0.1            # optional: reachable on every network address by default; set 127.0.0.1 (this machine only) or a private address to narrow it
ALLOWED_ORIGINS=https://app.example.com    # the address people open the site at

# ---- database (external; the same four values as every other part)
DATABASE_URL=postgresql://app_user:CHANGE_ME@host.docker.internal:5432/salesai
SYSTEM_DATABASE_URL=postgresql://app_system:CHANGE_ME@host.docker.internal:5432/salesai
MIGRATION_DATABASE_URL=postgresql://app_owner:CHANGE_ME@host.docker.internal:5432/salesai

# ---- secrets this part holds
# 32+ random characters; signs sign-in sessions
JWT_SECRET=
# 32+ random characters; hashes one-time codes
OTP_SECRET=

# ---- sign-in
OTP_CHANNEL=whatsapp_cloud      # codes are sent by the gateway; `simulator` for local development only
OTP_ACCEPT_ANY=false            # demo only: anyone can sign in as any number. Production refuses it
OTP_DELIVERY_WAIT_S=6           # how long a sign-in waits for the gateway to send the code
NUMBER_CONNECT_WAIT_S=30        # how long connecting a number waits for the gateway

# ---- public Embedded Signup values (the secret stays with the gateway)
META_APP_ID=
META_CONFIG_ID=
META_GRAPH_VERSION=v26.0
# META_SDK_URL=https://connect.facebook.net/en_US/sdk.js       # Meta's browser script for the sign-up popup (only change it to point at a test stand-in for Meta)
# META_SIGNUP_ORIGINS=https://www.facebook.com,https://web.facebook.com   # who the sign-up popup's messages are accepted from

# ---- billing
PAYMENT_PROVIDER=manual         # manual | test (test settles invoices without taking money; production refuses it)
PAYMENT_INSTRUCTIONS=Pay by UPI or bank transfer and quote the invoice number.
INVOICE_SELLER_NAME=[Company name]
INVOICE_SELLER_ADDRESS=[Registered address]
INVOICE_SELLER_GSTIN=[GSTIN]

# ---- platform alerts to YOU, never to shops (ADR 0029). Leave ALERT_EMAIL_TO empty to use the operator console only.
# comma-separated, e.g. you@yourcompany.example
ALERT_EMAIL_TO=
# a sender address your mail provider allows, e.g. alerts@yourcompany.example
ALERT_EMAIL_FROM=
# any provider that speaks SMTP (Amazon SES, Zoho, Brevo, Gmail workspace...)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls          # starttls (587) | ssl (465) | none (a local test server only)
SMTP_USERNAME=
# secret: put it here, never in chat or in git
SMTP_PASSWORD=
ALERT_MIN_SEVERITY=low          # low | medium | high | critical
# optional second path: High and Critical to a Slack/Teams/Discord-style incoming webhook
ALERT_WEBHOOK_URL=
# optional: Critical only, comma-separated, e.g. +919999900000
ALERT_WHATSAPP_NUMBERS=
PLATFORM_SENDER_PHONE_NUMBER_ID=
PLATFORM_WA_ACCESS_TOKEN=

# ---- the site
BRAND=ChatDeal
CONTACT_EMAIL=hello@chatdeal.example
WEBHOOK_UPSTREAM=host.docker.internal:8001   # where /webhooks goes: the gateway's `receive`
ALLOW_IPS=0.0.0.0/0 ::/0        # restrict who can open the site (space-separated addresses or ranges) while testing

# ---- queue (only if you run Redis instead of Postgres)
QUEUE_BACKEND=postgres
REDIS_URL=

# ---- optional (safe defaults)
# BACKEND_IMAGE=chatdeal-backend:local     # the image every part runs; build it once and reuse it
# FRONTEND_IMAGE=chatdeal-site:local
# API_BASE=                                # empty = same origin (the site proxies /api); set an absolute URL to point elsewhere
# SIMULATOR_ENABLED=false                  # development only: the simulated WhatsApp network. Production refuses it
# OTP_MIN_INTERVAL_S=20                    # seconds between code requests for one number
# OTP_PER_PHONE_PER_HOUR=5
# OTP_PER_IP_PER_HOUR=30
# META_GRAPH_BASE=https://graph.facebook.com
