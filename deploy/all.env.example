# ONE FILE FOR AN EASY DEPLOY (deploy/all.env). Copy this file to deploy/all.env and fill it in once; every part reads it, then reads its own deploy/<part>/.env on top
# (the part's own file wins, so anything you put there overrides this). A part is handed only the settings its own compose file names, so a secret that only the
# gateway needs never reaches the web part's containers, even though it sits in this one file.
#
# One file on disk means every secret is in one place: fine on your own machine, a convenience for a first go-live. A real server keeps separate per-part files
# (or a secrets manager). Never commit the filled-in file (it is git-ignored) and never paste it in chat.
#
# Used by scripts/stack.ps1 and scripts/stack.sh. fresh-start.ps1 keeps writing the per-part files, which override this one; delete a value there to let this file decide.

# ---- the environment
APP_ENV=dev
LOG_LEVEL=INFO

# ---- database (the same values in every part that connects)
DATABASE_URL=postgresql://app_user:CHANGE_ME@host.docker.internal:5432/salesai
SYSTEM_DATABASE_URL=postgresql://app_system:CHANGE_ME@host.docker.internal:5432/salesai
# used by the agent's turn worker only (the one login that can read floor prices)
PRICING_DATABASE_URL=postgresql://app_pricing:CHANGE_ME@host.docker.internal:5432/salesai
# used by the founder console only
CONSOLE_DATABASE_URL=postgresql://app_console:CHANGE_ME@host.docker.internal:5432/salesai
# used by the migration job only
MIGRATION_DATABASE_URL=postgresql://app_owner:CHANGE_ME@host.docker.internal:5432/salesai

# ---- secrets shared by several parts
# base64 of 32 random bytes. Back it up: if it is lost every shop must reconnect its WhatsApp
MASTER_KEY=
# 32+ random characters
JWT_SECRET=
# 32+ random characters
OTP_SECRET=
# 32+ random characters, DIFFERENT from JWT_SECRET (founder console only)
ADMIN_JWT_SECRET=

# ---- the site and the console addresses
ALLOWED_ORIGINS=http://localhost:8085
ADMIN_ALLOWED_ORIGINS=http://localhost:8082

# ---- WhatsApp (Meta). For a local test with the stand-in, scripts/connect-meta-sim.ps1 writes the per-part files instead
META_APP_ID=
META_CONFIG_ID=
META_GRAPH_VERSION=v26.0
META_APP_SECRET=
META_VERIFY_TOKEN=
PLATFORM_SENDER_PHONE_NUMBER_ID=
PLATFORM_WA_ACCESS_TOKEN=
OTP_CHANNEL=whatsapp_cloud

# ---- the model (OpenRouter by default; the address decides the vendor)
LLM_PROVIDER=openai_compat
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_THINKING_TOKENS=800
ANTHROPIC_API_KEY=

# ---- email (Amazon SES by default)
EMAIL_TRANSPORT=ses
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# used when EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# founder alerts: who gets them, and the sender (verified in SES)
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
# mail to shop owners (payment receipts, support). Empty = none. One sender is enough to start
CLIENT_EMAIL_FROM=
# optional: a hidden copy to a real mailbox, e.g. your Google Workspace support@
CLIENT_EMAIL_BCC_SUPPORT=
# the owner app's public address, used in mail links
SITE_URL=

# ---- the founder (console only; ADR 0056)
FOUNDER_PHONE=
FOUNDER_EMAIL=
# make one with: python -m salesai admin-enroll --new-secret
FOUNDER_TOTP_SECRET=
# who the console's sign-in code emails come from, e.g. ChatDeal Access <access@yourcompany.example>
ADMIN_EMAIL_FROM=
