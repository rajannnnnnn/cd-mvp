# Settings for the AGENT part (deploy/agent): the ChatDeal AI. Copy to deploy/agent/.env and fill in.
# Never commit the filled-in file. It holds no Meta secret and no WhatsApp token: by design the agent cannot reach WhatsApp.

APP_ENV=production              # dev | staging | production. production refuses the local stand-in model
LOG_LEVEL=INFO

# ---- database (external; the same four values as every other part)
DATABASE_URL=postgresql://app_user:CHANGE_ME@host.docker.internal:5432/salesai
PRICING_DATABASE_URL=postgresql://app_pricing:CHANGE_ME@host.docker.internal:5432/salesai
SYSTEM_DATABASE_URL=postgresql://app_system:CHANGE_ME@host.docker.internal:5432/salesai

# ---- the model (ADR 0034). Switching vendor, model or host is an edit here and a restart: no code change.
# Default: openai/gpt-oss-20b on every step, through any OpenAI-compatible host (Groq, Together, Fireworks, OpenRouter, your own).
LLM_PROVIDER=openai_compat      # openai_compat | anthropic   (production refuses `local`, the deterministic stand-in)
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_THINKING_TOKENS=0   # extra tokens each reply may use for a thinking model's reasoning (Gemini 2.5: try 2000; gpt-oss: 0-500). Billed only as used
LLM_MODEL_PLANNER=openai/gpt-oss-20b     # understands the customer
LLM_MODEL_WRITER=openai/gpt-oss-20b      # writes the reply
LLM_MODEL_CHECK=openai/gpt-oss-20b       # checks it before it is sent
LLM_EFFORT_PLANNER=medium       # low | medium | high
LLM_EFFORT_WRITER=medium
LLM_EFFORT_CHECK=low
# Run one step on another vendor, e.g. the writer on Claude:  LLM_PROVIDER_WRITER=anthropic  LLM_MODEL_WRITER=claude-sonnet-5-5
LLM_PROVIDER_PLANNER=
LLM_PROVIDER_WRITER=
LLM_PROVIDER_CHECK=
# only if a step (or the fallback) uses anthropic
ANTHROPIC_API_KEY=
LLM_FALLBACK_PROVIDER=none      # none | openai_compat | anthropic, used when a step's vendor fails
# the model the fallback runs
LLM_FALLBACK_MODEL=
# a model with no built-in price needs one: {"model": [input, output, cached_input, cache_write]} USD per 1M tokens
LLM_PRICES=
LLM_JSON_MODE=json_schema       # json_object for hosts without schema support
LLM_TIMEOUT_S=30

# ---- throughput
AGENT_CONCURRENCY=8             # jobs each copy runs at once; add copies with: scripts/stack.sh agent --scale agent=3

# ---- sign-in channel setting (the agent sends no codes; production just needs it not to be `simulator`)
OTP_CHANNEL=whatsapp_cloud

# ---- queue (only if you run Redis instead of Postgres)
QUEUE_BACKEND=postgres
REDIS_URL=

# ---- optional (safe defaults)
# BACKEND_IMAGE=chatdeal-backend:local     # the image every part runs; build it once and reuse it
# SIMULATOR_ENABLED=false                  # development only: the simulated WhatsApp network. Production refuses it
