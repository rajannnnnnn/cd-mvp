# Settings for the ADMIN part (deploy/admin): the founder's console. Copy to deploy/admin/.env and fill in. Never commit the filled-in file.
# It holds no Meta app secret and no model key. It does hold the master key (to register a pilot number by hand) and its own console secret.

APP_ENV=production              # dev | staging | production. production refuses placeholders and a console with no origin set
LOG_LEVEL=INFO
ADMIN_PORT=8082                 # the published port. Put a TLS proxy in front, on its own address, e.g. admin.yourcompany.example
ADMIN_BIND=127.0.0.1            # who can reach it: this machine only. A proxy on another machine: this machine's PRIVATE address, plus ADMIN_ALLOWED_IPS

# ---- the console's address and who may reach it
ADMIN_ALLOWED_ORIGINS=https://admin.example.com   # the console's own address; the API answers cross-origin calls from here only (never *)
ADMIN_ALLOWED_IPS=                                # optional: comma-separated addresses or ranges that may reach it (the API checks every request)
ALLOW_IPS=0.0.0.0/0 ::/0                          # optional: the same list, enforced at the edge by the web server (space-separated)
ADMIN_SESSION_MINUTES=30                          # a console session; extended only by a fresh authenticator code

# ---- database (external; the same four values as every other part)
DATABASE_URL=postgresql://app_user:CHANGE_ME@host.docker.internal:5432/salesai
SYSTEM_DATABASE_URL=postgresql://app_system:CHANGE_ME@host.docker.internal:5432/salesai
CONSOLE_DATABASE_URL=postgresql://app_console:CHANGE_ME@host.docker.internal:5432/salesai   # one-off: ALTER ROLE app_console LOGIN PASSWORD '...' (docs/ADMIN_CONSOLE.md)
MIGRATION_DATABASE_URL=postgresql://app_owner:CHANGE_ME@host.docker.internal:5432/salesai

# ---- secrets this part holds
ADMIN_JWT_SECRET=               # 32+ random characters, DIFFERENT from JWT_SECRET. Only this part holds it: the shop app cannot sign or accept console sessions
MASTER_KEY=                     # base64 of 32 random bytes. SAME value as the gateway (it registers a pilot number by hand). Back it up
JWT_SECRET=                     # 32+ random characters; same as the web part (a break-glass read opens a shop session)
OTP_SECRET=                     # 32+ random characters; same as the web part (the WhatsApp code of the console sign-in)

# ---- sign-in
OTP_CHANNEL=whatsapp_cloud      # the console's WhatsApp code is sent by the gateway
OTP_DELIVERY_WAIT_S=6           # how long a sign-in waits for the gateway to send the code

# ---- optional (the defaults are right for one machine)
# QUEUE_BACKEND=postgres        # the same value as every other part: the console reads queue depth from it
# REDIS_URL=                    # only if QUEUE_BACKEND=redis
# BACKEND_IMAGE=                # pin the backend image (default: built from ../../backend)
# ADMIN_FRONTEND_IMAGE=         # pin the console's web image
# API_BASE=                     # leave empty: the console's web server proxies /admin/v1 and /api/v1/operator to its API

