# Settings for the database migration job (deploy/db). Copy to deploy/db/.env and fill in. Never commit the filled-in file.
# This is the only part that holds the schema-owner credential.

APP_ENV=production              # dev | staging | production
LOG_LEVEL=INFO

# The database is external. From inside a container the host machine is host.docker.internal.
# Create the four roles first with db/bootstrap_roles.sql, then put their passwords here.
DATABASE_URL=postgresql://app_user:CHANGE_ME@host.docker.internal:5432/salesai
PRICING_DATABASE_URL=postgresql://app_pricing:CHANGE_ME@host.docker.internal:5432/salesai
SYSTEM_DATABASE_URL=postgresql://app_system:CHANGE_ME@host.docker.internal:5432/salesai
MIGRATION_DATABASE_URL=postgresql://app_owner:CHANGE_ME@host.docker.internal:5432/salesai

# ---- optional (safe defaults)
# BACKEND_IMAGE=chatdeal-backend:local     # the image every part runs; build it once and reuse it
# OTP_CHANNEL=whatsapp_cloud
