# ======================================================================================
# WhatsApp AI Sales Assistant — environment configuration (copy to .env; never commit secrets)
# Everything that differs between deployments lives here, is validated at startup, and an invalid
# value stops the process. Per-business behaviour (timings, limits, style) is data in the database.
# ======================================================================================

# ---- process
ENV=dev                         # dev | staging | production
ROLE=all                        # api | ingress | web | worker | scheduler | migrate | all
LOG_LEVEL=INFO
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
TRUST_PROXY=true                # honour X-Forwarded-For from the reverse proxy
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080   # CORS: where the frontend is served from

# ---- database: four roles with least privilege (see db/bootstrap_roles.sql)
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/salesai          # tenant work; Row-Level Security applies
PRICING_DATABASE_URL=postgresql://app_pricing:CHANGE_ME@localhost:5432/salesai # the ONLY role that can read floor prices
SYSTEM_DATABASE_URL=postgresql://app_system:CHANGE_ME@localhost:5432/salesai   # platform work (BYPASSRLS)
MIGRATION_DATABASE_URL=postgresql://app_owner:CHANGE_ME@localhost:5432/salesai # migrations only
DB_POOL_MAX=10

# ---- queue / storage
QUEUE_BACKEND=postgres          # postgres | redis
REDIS_URL=redis://localhost:6379/0
WORKER_QUEUES=inbound.events,conversation.turns,outbound.actions,owner.notifications,platform.events
WORKER_CONCURRENCY=8
RELAY_POLL_MS=100
BLOB_BACKEND=fs
BLOB_PATH=./.data/blobs

# ---- secrets (generate real ones: `openssl rand -base64 32`)
MASTER_KEY=                     # base64 of 32 bytes: wraps per-tenant data keys that encrypt WhatsApp access tokens
JWT_SECRET=                     # >= 32 chars
OTP_SECRET=                     # >= 32 chars
META_APP_SECRET=                # Meta app secret: verifies X-Hub-Signature-256 on every webhook
META_VERIFY_TOKEN=              # webhook subscription handshake token
META_APP_ID=                    # Meta app id (Embedded Signup); with META_CONFIG_ID turns on "Connect WhatsApp" in Settings
META_CONFIG_ID=                 # Embedded Signup configuration id (from the Meta app dashboard)
META_GRAPH_VERSION=v21.0
META_GRAPH_BASE=https://graph.facebook.com

# ---- sign-in
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000
OTP_TTL_S=300
OTP_MAX_ATTEMPTS=5
OTP_ACCEPT_ANY=false            # DEMO ONLY: when true any code signs a number in; the app refuses to start with it in production
OTP_MIN_INTERVAL_S=20
OTP_PER_PHONE_PER_HOUR=5
OTP_PER_IP_PER_HOUR=30
OTP_CHANNEL=simulator           # simulator (dev) | whatsapp_cloud (production: an authentication template on the platform number)
PLATFORM_SENDER_PHONE_NUMBER_ID=sim-platform
PLATFORM_WA_ACCESS_TOKEN=

# ---- channels
SIMULATOR_ENABLED=true          # MUST be false in production (enforced at startup)

# ---- LLM (vendor and models are configuration)
LLM_PROVIDER=local              # local (deterministic stand-in, dev/test only) | anthropic
LLM_FALLBACK_PROVIDER=none      # none | local | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MODEL_PLANNER=claude-sonnet-5-5
LLM_MODEL_WRITER=claude-sonnet-5-5
LLM_MODEL_CHECK=claude-haiku-4-5
LLM_TIMEOUT_S=30

# ---- billing
PAYMENT_PROVIDER=test           # test = settles instantly, no money moves (demo); manual = bank transfer/UPI marked paid by the platform team (production)
PAYMENT_INSTRUCTIONS=Pay by UPI or bank transfer to the account shared by our team and quote the invoice number.
INVOICE_SELLER_NAME=[Company name]
INVOICE_SELLER_ADDRESS=[Registered address]
INVOICE_SELLER_GSTIN=[GSTIN]

# ---- alert routing (operator alerts pushed to the platform team; leave empty to use the console only)
ALERT_WEBHOOK_URL=              # JSON POST with a `text` field: works with Slack/Teams/Discord-style incoming webhooks
ALERT_WHATSAPP_NUMBERS=         # comma-separated E.164 numbers, sent with the approved `operator_alert` template
ALERT_MIN_SEVERITY=warning      # info | warning | critical
ALERT_REMINDER_MINUTES=60       # unresolved critical alerts repeat at this interval

# ---- safety bounds (per-business values are data in the database; these are the platform ceilings/defaults)
MAX_TURN_WAIT_MS_CEILING=60000  # no business may configure a longer wait before answering
MAX_AI_TURNS_PER_CONVERSATION_10MIN=30 # flood guard: AI turns allowed per conversation per 10 minutes; extra messages are recorded, not answered
DEFAULT_OWNER_PAUSE_MINUTES=120 # AI pause after the owner replies manually, for businesses that have not set their own
