# ======================================================================================
# WhatsApp AI Sales Assistant — environment configuration (copy to .env; never commit secrets)
# Everything that differs between deployments lives here, is validated at startup, and an invalid
# value stops the process. Per-business behaviour (timings, limits, style) is data in the database.
# ======================================================================================

# ---- process
ENV=dev                         # dev | staging | production
ROLE=all                        # api | ingress | web | worker | scheduler | migrate | all
LOG_LEVEL=INFO
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
TRUST_PROXY=true                # honour X-Forwarded-For from the reverse proxy
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080   # CORS: where the frontend is served from

# ---- database: four roles with least privilege (see db/bootstrap_roles.sql)
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/salesai          # tenant work; Row-Level Security applies
PRICING_DATABASE_URL=postgresql://app_pricing:CHANGE_ME@localhost:5432/salesai # the ONLY role that can read floor prices
SYSTEM_DATABASE_URL=postgresql://app_system:CHANGE_ME@localhost:5432/salesai   # platform work (BYPASSRLS)
CONSOLE_DATABASE_URL=postgresql://app_console:CHANGE_ME@localhost:5432/salesai  # the founder console only (roles admin and all); the one login that can read admin sign-in secrets
MIGRATION_DATABASE_URL=postgresql://app_owner:CHANGE_ME@localhost:5432/salesai # migrations only
DB_POOL_MAX=10

# ---- queue / storage
QUEUE_BACKEND=postgres          # postgres | redis
REDIS_URL=redis://localhost:6379/0
WORKER_QUEUES=inbound.events,conversation.events,conversation.turns,outbound.actions,owner.notifications,platform.events
SCHEDULER_COMPONENT=all                     # which component's timers this scheduler runs: web | gateway | agent | all (dev) (ADR 0025)
WORKER_CONCURRENCY=8
RELAY_POLL_MS=100
BLOB_BACKEND=fs
BLOB_PATH=./.data/blobs

# ---- secrets (generate real ones: `openssl rand -base64 32`)
# base64 of 32 bytes: wraps per-tenant data keys that encrypt WhatsApp access tokens
MASTER_KEY=
# >= 32 chars
JWT_SECRET=
# >= 32 chars
OTP_SECRET=
# Meta app secret: verifies X-Hub-Signature-256 on every webhook
META_APP_SECRET=
# webhook subscription handshake token
META_VERIFY_TOKEN=
# Meta app id (Embedded Signup); with META_CONFIG_ID turns on "Connect WhatsApp" in Settings
META_APP_ID=
# Embedded Signup configuration id (from the Meta app dashboard)
META_CONFIG_ID=
META_GRAPH_VERSION=v21.0
META_GRAPH_BASE=https://graph.facebook.com

# ---- sign-in
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000
OTP_TTL_S=300
OTP_MAX_ATTEMPTS=5
OTP_ACCEPT_ANY=false            # DEMO ONLY: when true any code signs a number in; the app refuses to start with it in production
OTP_MIN_INTERVAL_S=20
OTP_PER_PHONE_PER_HOUR=5
OTP_PER_IP_PER_HOUR=30
OTP_CHANNEL=whatsapp_cloud      # whatsapp_cloud (the default: codes go through Meta, or through tools/meta-sim pointed at by META_GRAPH_BASE) | simulator (the product's own stand-in, development only)
PLATFORM_SENDER_PHONE_NUMBER_ID=sim-platform
PLATFORM_WA_ACCESS_TOKEN=

# ---- channels
SIMULATOR_ENABLED=false         # the product's own in-process stand-in network: development and tests only; MUST be false in production (enforced at startup). Prefer tools/meta-sim, wired by the META_* settings

# ---- LLM (vendor and models are configuration)
# --- LLM (ADR 0034). Vendor, model and effort per pipeline stage are configuration: switching is an edit and a restart.
# Startup refuses a vendor without its key, a non-claude model on anthropic, a malformed LLM_PRICES, a configured
# model with no known price (it would silently record every turn as free), and `local` anywhere in production.
LLM_PROVIDER=local              # local (deterministic stand-in, dev/test only) | openai_compat | anthropic
# optional per-stage override; empty = LLM_PROVIDER
LLM_PROVIDER_PLANNER=
#   e.g. keep gpt-oss everywhere but run the writer on another vendor
LLM_PROVIDER_WRITER=
LLM_PROVIDER_CHECK=
LLM_FALLBACK_PROVIDER=none      # none | openai_compat | anthropic — used when a stage's vendor fails
# the model the fallback runs (it cannot run another vendor's model name); empty = same model
LLM_FALLBACK_MODEL=
# OpenAI-compatible hosts serve openai/gpt-oss-20b: Groq, Together, Fireworks, OpenRouter, or a self-hosted vLLM.
# e.g. https://api.groq.com/openai/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_THINKING_TOKENS=0   # extra tokens each reply may use for a thinking model's reasoning (Gemini 2.5: try 2000; gpt-oss: 0-500). Billed only as used
LLM_JSON_MODE=json_schema       # json_schema | json_object (for hosts without schema support; replies are validated either way)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MODEL_PLANNER=openai/gpt-oss-20b   # founder's default on every stage until the benchmark says a stage needs more
LLM_MODEL_WRITER=openai/gpt-oss-20b
LLM_MODEL_CHECK=openai/gpt-oss-20b
LLM_EFFORT_PLANNER=medium       # low | medium | high. gpt-oss Hindi MMMLU: 70 low, 77 medium, 79 high
LLM_EFFORT_WRITER=medium
LLM_EFFORT_CHECK=low
# Prices for models or hosts not built in, USD per 1M tokens: {"model": [input, output, cached_input, cache_write]}
# e.g. LLM_PRICES={"openai/gpt-oss-120b": [0.15, 0.60, 0.075, 0.15]}   (illustrative numbers, not a quote: check the host's price page)
LLM_PRICES=
LLM_TIMEOUT_S=30

# --- Web <-> gateway requests (ADR 0025). The web component never talks to Meta: it writes a request (a sign-in code, a
# number connect) and waits for the gateway's answer. If the gateway does not answer in time the owner is told to try again.
OTP_DELIVERY_WAIT_S=6                         # how long a sign-in request waits for the gateway to send the code
NUMBER_CONNECT_WAIT_S=30                      # how long a number connect waits (it makes several calls to Meta)

# --- Meta message pricing (ADR 0026), for the per-shop usage estimate (GET /api/v1/operator/businesses/{id}/meta-usage).
# Estimates only: Meta changed these twice in 2026 - re-check Meta's own pricing page. INR per delivered message.
META_RATES_INR={"service": 0.115, "utility": 0.115, "authentication": 0.115, "marketing": 0.8631}
META_FREE_SERVICE_PER_NUMBER=1000   # free service messages per business number per calendar month (since 1 Oct 2026)

# --- Retention (ADR 0030). How long to keep customers' chats is a privacy/legal policy: 0 = keep while the shop is active.
CHAT_RETENTION_DAYS=0                         # messages, owner alerts, learning records
TURN_RETENTION_DAYS=0                         # AI decision records (cost and audit data)
SIM_MESSAGE_RETENTION_DAYS=30                 # simulator chats (demo data)
RESOLVED_ALERT_RETENTION_DAYS=180             # operator alerts after they are resolved (unresolved are never purged)
RESOLVED_TICKET_ATTACHMENT_RETENTION_DAYS=180 # pictures on support tickets resolved this long ago

# ---- billing
PAYMENT_PROVIDER=test           # test = settles instantly, no money moves (demo); manual = bank transfer/UPI marked paid by the platform team (production)
PAYMENT_INSTRUCTIONS=Pay by UPI or bank transfer to the account shared by our team and quote the invoice number.
INVOICE_SELLER_NAME=[Company name]
INVOICE_SELLER_ADDRESS=[Registered address]
INVOICE_SELLER_GSTIN=[GSTIN]

# ---- alert routing (platform alerts to the founder, never to shops; leave empty to use the operator console only; ADR 0029)
# comma-separated recipients, e.g. you@yourcompany.example
ALERT_EMAIL_TO=
# the sender address your mail provider allows
ALERT_EMAIL_FROM=
# any SMTP provider (Amazon SES, Zoho, Brevo...)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls          # starttls | ssl | none (none only for a local test server)
SMTP_USERNAME=
# secret
SMTP_PASSWORD=
# JSON POST with a `text` field (High and Critical): works with Slack/Teams/Discord-style incoming webhooks
ALERT_WEBHOOK_URL=
# comma-separated E.164 numbers (Critical only), sent with the approved `operator_alert` template
ALERT_WHATSAPP_NUMBERS=
ALERT_MIN_SEVERITY=low          # low | medium | high | critical (old values info/warning still load)
ALERT_REMINDER_MINUTES=30       # an unresolved Critical alert repeats at this interval
ALERT_HIGH_COOLDOWN_MINUTES=30  # a High alert is repeated at most this often, and only if it happened again
ALERT_MEDIUM_ROLLUP_MINUTES=60  # Medium alerts are gathered into one email per this interval
ALERT_LOW_DIGEST_MINUTES=1440   # Low alerts are gathered into one digest per this interval
# ---- knowing when a part is down (ADR 0046)
HEARTBEAT_EVERY_S=30            # every process records that it is alive this often
PART_DOWN_AFTER_S=120           # a part unseen this long raises a part_down alert (at least twice HEARTBEAT_EVERY_S)
QUEUE_STALL_ALERT_S=300         # a queue whose oldest due job waits this long raises queue_stalled
# web scheduler only: an outside dead-man's switch (healthchecks.io, Better Stack, Cronitor...) that alerts you when the posts stop. Empty = off
ALERT_HEARTBEAT_URL=

# ---- rules before models (ADR 0039): the planner tries deterministic rules first for the cases they are sure of and that are safe for them
TIERING_ENABLED=true            # false = every planner step goes to the language model
# comma-separated intents the rules may decide alone; empty = the built-in safe list (greetings, thanks, goodbyes, "are you a bot", "I want the owner", complaints, "not interested", photos and voice notes, shop facts, and a price / availability ask that names the product exactly). Money, negotiation and commitments are never on it.
TIERING_PLANNER_INTENTS=
TIERING_SKIP_CHECK_WHEN_LOW_RISK=true   # skip the optional model check for replies that state nothing risky (greetings, thanks, a question back)

# ---- the founder's admin console (ADR 0028): its own application, its own secret, its own origin
# at least 32 characters, different from JWT_SECRET; held by the admin part only
ADMIN_JWT_SECRET=
ADMIN_SESSION_MINUTES=30        # a console session; there is no refresh, only a fresh authenticator code
# the console's own origin, e.g. https://admin.yourcompany.example (required in production, never *)
ADMIN_ALLOWED_ORIGINS=
# optional: comma-separated addresses or ranges that may reach the console (empty = anyone who can sign in)
ADMIN_ALLOWED_IPS=

# ---- restart tolerance (ADR 0035)
WORKER_LEASE_S=30               # a job's lease; renewed every third of it while it runs, so a crashed worker's jobs return within about this long
WORKER_SHUTDOWN_GRACE_S=20      # on a stop request, finish in-flight jobs for this long, then give the rest back immediately
RECOVERY_STUCK_AFTER_S=90       # an unanswered customer message this old that nobody is working on is re-driven
RECOVERY_RETRY_AFTER_S=180      # ...and given this long before it is tried again
RECOVERY_MAX_ATTEMPTS=3         # after this many tries the owner is handed the chat and the founder is alerted
RECOVERY_QUEUED_REPLY_S=120     # a reply planned this long ago and still not sent is requested again
RECOVERY_MAILBOX_S=60           # a hand-off between components that nobody picked up for this long is requested again

# ---- safety bounds (per-business values are data in the database; these are the platform ceilings/defaults)
MAX_TURN_WAIT_MS_CEILING=60000  # no business may configure a longer wait before answering
MAX_AI_TURNS_PER_CONVERSATION_10MIN=30 # flood guard: AI turns allowed per conversation per 10 minutes; extra messages are recorded, not answered
RAW_WEBHOOK_RETENTION_DAYS=30           # how long the raw log keeps verified WhatsApp webhooks (exact bytes + signature)
INVALID_WEBHOOK_RETENTION_DAYS=3        # requests that failed signature verification are kept as evidence, but only this long
INVALID_WEBHOOK_MAX_BYTES=4096          # at most this many bytes of a failed request's body are stored
DEFAULT_OWNER_PAUSE_MINUTES=120 # AI pause after the owner replies manually, for businesses that have not set their own

# ---- split stacks (backend / AI engine / external database): configured in deploy/standalone/.env.example, separate from the demo

# --- Meta's browser sign-up (Embedded Signup). Defaults are Meta's own addresses; change them only to point at a stand-in for Meta (tools/meta-sim), never in production
META_SDK_URL=https://connect.facebook.net/en_US/sdk.js
META_SIGNUP_ORIGINS=https://www.facebook.com,https://web.facebook.com   # origins the sign-up popup's messages are accepted from

# --- deleting a shop: days between the owner's request and the erasure (ADR 0044); the owner can cancel until then
DELETION_GRACE_DAYS=60

# --- the founder's console sign-in (ADR 0047, 0048)
# the one founder's WhatsApp number, e.g. +919876543210. Fixed at deployment; the authenticator is enrolled for this person (python -m salesai admin-enroll)
FOUNDER_PHONE=
ADMIN_DEVICE_TRUST_DAYS=30           # how long a browser that signed in with a WhatsApp code too is remembered, so a routine sign-in needs only the authenticator
# optional: the proxy's country header (e.g. CF-IPCountry) shown next to each sign-in's address
ADMIN_GEO_HEADER=
