# The founder's console: its own build (npm run build:admin) and its own Caddy, separate from the owner app's image (ADR 0028).
FROM node:22-alpine AS build
WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build:admin

FROM caddy:2-alpine
COPY --from=build /web/dist-admin /srv
COPY deploy/Caddyfile.admin /etc/caddy/Caddyfile
COPY deploy/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh /etc/caddy/Caddyfile
ENV API_BASE="" SITE_ADDRESS=":80" API_UPSTREAM="api:8000"
EXPOSE 80 443
ENTRYPOINT ["/bin/sh", "/entrypoint.sh"]
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
